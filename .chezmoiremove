# Targets chezmoi should remove from the destination on `chezmoi apply`.
# Use for orphans left behind by deletions in the source tree — chezmoi
# does NOT auto-remove targets when a source file disappears.
#
# Format: one target path per line, relative to the destination dir
# (typically $HOME). Blank lines and `#` comments allowed. Removed
# entries can be deleted from this list once all known hosts have applied.

# fzf.sh fragment removed in PR #38 (chore(shell): drop fzf integration).
# Without this line, the orphan keeps emitting "(eval):1: can't change
# option: zle" at every interactive zsh startup on machines that already
# had it deployed.
.config/shell/fzf.sh

# Custom /code-review retired in 1f8865d (feat(claude): retire the custom
# /code-review, use the built-in). A user-level command SHADOWS the built-in
# of the same name, so an orphan here is not inert: the built-in's effort
# levels stop working, and `/code-review low` dies with an unknown-revision
# error because the old command passed its whole argument to `review-diff`,
# which takes a branch or --since and reads "low" as a branch name.
.claude/commands/code-review.md
