# Source-only assets — chezmoi scripts read these from the source dir,
# they should never be deployed into $HOME.
packages/
scripts/
Brewfile
mas.txt

# Repo meta — present in source for the repo's own sake, not for $HOME.
README.md
install.sh
copier.yml
docs/
templates/
tests/

# Python bytecode caches (e.g. left by running tests from the source tree).
**/__pycache__
**/*.pyc

# macOS-only .chezmoiscripts/* gate themselves inside the template with
# an `eq .chezmoi.os "darwin"` check — chezmoiignore does not apply to
# .chezmoiscripts.

{{ if ne .chezmoi.os "darwin" }}
Library/
.config/cspell/
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.config/Code/
.local/share/code-server/
{{ end }}
