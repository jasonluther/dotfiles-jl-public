name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: true

env:
  # Self-hosted toggle: set vars.RUNS_ON to 'self-hosted' in repo settings
  # (scripts/set-runner.sh) to run PR workflows on the local macOS runner
  # pool. It applies only while the repo is private: a public repo, a
  # push to main and a Dependabot PR always use GitHub-hosted ubuntu-latest.
  # Fork PRs in a private repo do use it: only people with read access can
  # fork a private repo, and it runs fork PRs only if that setting is on.
  IS_SELF_HOSTED: ${{ '{{' }} (github.event.repository.private && github.event_name != 'push' && github.actor != 'dependabot[bot]' && vars.RUNS_ON == 'self-hosted') {{ '}}' }}

jobs:
  test:
    runs-on: ${{ '{{' }} (github.event.repository.private && github.event_name != 'push' && github.actor != 'dependabot[bot]' && vars.RUNS_ON) || 'ubuntu-latest' {{ '}}' }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0

      - uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78 # v7.6.0
        if: env.IS_SELF_HOSTED != 'true'
        with:
          enable-cache: true
          cache-dependency-glob: uv.lock

      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        if: env.IS_SELF_HOSTED != 'true'
        with:
          python-version: "{{ python_version }}"

      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6.5.0
        if: env.IS_SELF_HOSTED != 'true'
        with:
          node-version: 'lts/*'
          cache: npm

      - uses: actions/cache@caa296126883cff596d87d8935842f9db880ef25 # v5.1.0
        if: env.IS_SELF_HOSTED != 'true'
        with:
          path: ~/.cache/pre-commit
          key: pre-commit-${{ '{{' }} runner.os {{ '}}' }}-${{ '{{' }} hashFiles('.pre-commit-config.yaml') {{ '}}' }}

      - name: Install dependencies
        run: |
          uv sync --frozen --group dev
          npm ci

      # Shared kilotronic/checks/lint: shellcheck, actionlint and the pinned-SHA check.
      - name: Lint shell scripts and workflows
        uses: kilotronic/checks/lint@a6e8917fddb679077a2e8a427598ff1fd7a160ef # v1.0.0

      - name: Lint and typecheck
        env:
          # Skip slow hooks (test suite runs as a separate step below for
          # better log readability; vale runs in pre-commit only), the
          # kilotronic/checks/lint hooks (the step above runs the same checks), and
          # the hooks that check this machine or staged changes (CI checks
          # commits in secrets-scan.yml instead).
          SKIP: pytest,vale-spelling-gate,shellcheck,actionlint,pinned,git-identity,secret-scan
        run: uv run pre-commit run --all-files

      - name: Run tests
        run: uv run pytest -n auto --tb=short -q

  ci:
    if: always()
    needs: [test]
    runs-on: ubuntu-latest
    steps:
      - name: Check results
        run: |
          if [[ "${{ '{{' }} needs.test.result {{ '}}' }}" != "success" ]]; then
            echo "test=${{ '{{' }} needs.test.result {{ '}}' }}"
            exit 1
          fi
