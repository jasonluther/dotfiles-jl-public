# Pre-commit configuration.
# Pre-commit is the primary quality gate: heavy checks (full test suite, license check)
# run in pre-commit so CI rarely fails. CI runs the same hooks via
# `pre-commit run --all-files` with the slow ones SKIP-listed.
# Install: `pre-commit install` (installs the pre-commit and pre-push hooks).

default_install_hook_types: [pre-commit, pre-push]
default_stages: [pre-commit]

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: 3e8a8703264a2f4a69428a0aa4dcb512790b2c8c # frozen: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-json
      - id: check-toml
      - id: check-added-large-files
        args: ["--maxkb=1024"]
      - id: check-merge-conflict
      - id: debug-statements
      - id: detect-private-key

  # Shared kilotronic tools, pinned to release commits.
  - repo: https://github.com/kilotronic/checks
    rev: a6e8917fddb679077a2e8a427598ff1fd7a160ef # frozen: v1.0.0
    hooks:
      - id: secret-scan # pre-commit: the staged changes (gitleaks)
      - id: secret-scan-push # pre-push: the commits being pushed
      - id: git-identity
        fail_fast: true
      - id: shellcheck
      - id: actionlint
      - id: pinned

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: 6fec9b7edb08fd9989088709d864a7826dc74e80 # frozen: v0.15.12
    hooks:
      - id: ruff
        args: [--fix, --exit-non-zero-on-fix]
      - id: ruff-format

  - repo: local
    hooks:
      - id: pyright
        name: pyright type checking
        entry: npx --yes pyright
        language: system
        types: [python]
        pass_filenames: false
        stages: [pre-commit]

  - repo: https://github.com/igorshubovych/markdownlint-cli
    rev: e72a3ca1632f0b11a07d171449fe447a7ff6795e # frozen: v0.48.0
    hooks:
      - id: markdownlint
        args: ["--config", ".markdownlint.yaml"]

  - repo: local
    hooks:
      - id: vale-spelling-gate
        name: Vale spelling check
        entry: vale --minAlertLevel=error
        language: system
        types_or: [markdown]
        stages: [pre-commit]

      - id: pytest
        name: Run full test suite
        entry: .venv/bin/python -m pytest -n auto --tb=short -q
        language: system
        files: ^(src/|tests/)
        pass_filenames: false
        stages: [pre-commit]

      # Checks the project's own environment (.venv, from `uv sync --group dev`).
      # A package with no license metadata (UNKNOWN) is not on the list, so it fails.
      - id: pip-licenses
        name: License compliance check
        entry: .venv/bin/pip-licenses --allow-only="Apache-2.0;Apache Software License;MIT;MIT License;BSD;BSD License;BSD-2-Clause;BSD-3-Clause;Python Software Foundation;Python Software Foundation License;PSF-2.0;ISC License;ISC License (ISCL);Mozilla Public License 2.0;Mozilla Public License 2.0 (MPL 2.0);Unlicense;The Unlicense;The Unlicense (Unlicense);MIT AND Python-2.0;Apache-2.0 OR BSD-2-Clause"
        language: system
        files: (pyproject\.toml|uv\.lock)$
        pass_filenames: false
        stages: [pre-commit]
