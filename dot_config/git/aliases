[alias]
	s = status --short --branch
	cm = commit -m
	aa = add --all
	co = checkout
	cob = checkout -b
	p = push
	pl = pull
	pu = push -u origin HEAD
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	wip = !git add -A && git commit -m "WIP"
	save = !git add -A && git commit -m "SAVEPOINT"
