#!/usr/bin/env bash
# gen-secrets — write a gitignored secrets.h (WIFI_SSID/WIFI_PASS) from the
# credentials this host already has, so you never hand-copy WiFi creds into an
# embedded project.
#
# Run it on a machine that's on the *deployment* WiFi — the network the device
# must join, not whatever WiFi is near your build box. It's a deliberate, opt-in
# step; don't wire it into a build.
#
# Credential source precedence:
#   1. explicit         --ssid/--psk      (or env WIFI_SSID / WIFI_PASS)
#   2. this host's WiFi  Linux: NetworkManager (nmcli, sudo for the PSK)
#                        macOS: keychain (networksetup + security)
#   3. 1Password (op)    fallback if step 2 fails and op refs are set
#                        (--op-ssid/--op-pass or env WIFI_OP_SSID_REF/WIFI_OP_PASS_REF)
#
# Usage:
#   gen-secrets [--out PATH] [--force]          # default PATH: ./secrets.h
#   gen-secrets --ssid MyNet --psk 's3cr3t'
#   WIFI_OP_SSID_REF='op://Home/shop-wifi/network' \
#   WIFI_OP_PASS_REF='op://Home/shop-wifi/password' gen-secrets
set -euo pipefail

die() {
  echo "gen-secrets: $*" >&2
  exit 1
}

force=0
out="./secrets.h"
opt_ssid=""
opt_psk=""
opt_op_ssid=""
opt_op_pass=""
while [ $# -gt 0 ]; do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --out)
      out="$2"
      shift 2
      ;;
    --ssid)
      opt_ssid="$2"
      shift 2
      ;;
    --psk)
      opt_psk="$2"
      shift 2
      ;;
    --op-ssid)
      opt_op_ssid="$2"
      shift 2
      ;;
    --op-pass)
      opt_op_pass="$2"
      shift 2
      ;;
    -h | --help)
      sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) die "unknown option $1 (try --help)" ;;
  esac
done

SSID=""
PASS=""
SRC=""
c_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

try_explicit() {
  local s="${opt_ssid:-${WIFI_SSID:-}}" p="${opt_psk:-${WIFI_PASS:-}}"
  [ -n "$s" ] && [ -n "$p" ] || return 1
  SSID="$s"
  PASS="$p"
  SRC="explicit args/env"
}

detect_linux() {
  command -v nmcli >/dev/null 2>&1 || return 1
  local conn
  conn="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
    | awk -F: '$2 ~ /wireless/ {print $1; exit}')"
  [ -n "$conn" ] || {
    echo "gen-secrets: no active WiFi connection (on wired only?)." >&2
    return 1
  }
  SSID="$(nmcli -t -g 802-11-wireless.ssid connection show "$conn" 2>/dev/null)"
  [ -n "$SSID" ] || SSID="$conn"
  PASS="$(nmcli -s -g 802-11-wireless-security.psk connection show "$conn" 2>/dev/null || true)"
  if [ -z "$PASS" ]; then
    echo "gen-secrets: reading the PSK needs sudo (NetworkManager stores it root-only)…" >&2
    PASS="$(sudo nmcli -s -g 802-11-wireless-security.psk connection show "$conn" 2>/dev/null || true)"
  fi
  [ -n "$PASS" ] || {
    echo "gen-secrets: no PSK for '$conn' (open/802.1x network?)." >&2
    return 1
  }
  SRC="NetworkManager ($conn)"
}

detect_macos() {
  local dev ssid
  dev="$(networksetup -listallhardwareports 2>/dev/null \
    | awk '/Wi-Fi|AirPort/{getline; print $NF; exit}')"
  dev="${dev:-en0}"
  ssid="$(networksetup -getairportnetwork "$dev" 2>/dev/null \
    | sed -n 's/^Current Wi-Fi Network: //p')"
  [ -n "$ssid" ] || {
    echo "gen-secrets: could not read current SSID (grant Location permission, or use --ssid)." >&2
    return 1
  }
  SSID="$ssid"
  echo "gen-secrets: reading the WiFi password from the keychain (you may be prompted to allow)…" >&2
  PASS="$(security find-generic-password -ga "$SSID" -w 2>/dev/null || true)"
  [ -n "$PASS" ] || {
    echo "gen-secrets: keychain lookup failed for '$SSID'." >&2
    return 1
  }
  SRC="macOS keychain"
}

try_op() {
  local sref="${opt_op_ssid:-${WIFI_OP_SSID_REF:-}}" pref="${opt_op_pass:-${WIFI_OP_PASS_REF:-}}"
  [ -n "$pref" ] || return 1
  command -v op >/dev/null 2>&1 || {
    echo "gen-secrets: op (1Password CLI) not installed." >&2
    return 1
  }
  echo "gen-secrets: reading credentials from 1Password (op)…" >&2
  PASS="$(op read "$pref" 2>/dev/null || true)"
  [ -n "$PASS" ] || {
    echo "gen-secrets: op could not read $pref (signed in? 'op signin')." >&2
    return 1
  }
  if [ -n "$sref" ]; then SSID="$(op read "$sref" 2>/dev/null || true)"; fi
  [ -n "${SSID:-}" ] || die "1Password gave a password but no SSID — set --op-ssid / WIFI_OP_SSID_REF (or --ssid)."
  SRC="1Password"
}

# precedence: explicit -> host WiFi (platform) -> 1Password -> fail
if ! try_explicit; then
  ok=1
  case "$(uname -s)" in
    Linux) detect_linux || ok=0 ;;
    Darwin) detect_macos || ok=0 ;;
    *) ok=0 ;;
  esac
  if [ "$ok" -ne 1 ]; then
    try_op || die "could not obtain WiFi credentials. Pass --ssid/--psk, or set op refs (--op-pass / WIFI_OP_PASS_REF)."
  fi
fi
[ -n "$SSID" ] && [ -n "$PASS" ] || die "internal: missing SSID or PASS after resolution."

[ -e "$out" ] && [ "$force" -ne 1 ] && die "$out already exists — re-run with --force to overwrite."

umask 077
{
  echo "#pragma once"
  echo "// Generated by gen-secrets (source: $SRC). Gitignored — never commit."
  printf '#define WIFI_SSID "%s"\n' "$(c_escape "$SSID")"
  printf '#define WIFI_PASS "%s"\n' "$(c_escape "$PASS")"
} >"$out"
chmod 600 "$out" 2>/dev/null || true

echo "gen-secrets: wrote $out  (SSID \"$SSID\", source: $SRC)" # never prints the password
