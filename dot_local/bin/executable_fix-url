#!/usr/bin/env python3
"""fix-url — clean a terminal-wrapped URL and open it.

SSH sessions that print long OAuth URLs (`claude /login`, `gh auth login`,
`aws sso login`, ...) wrap them across lines. Selecting/copying that in a
terminal embeds newlines (and sometimes stray spaces) in the copy. fix-url
strips all whitespace from the clipboard (or piped stdin), pulls the URL
out of any brackets or Markdown link around it (`(url)`, `[url]`, `<url>`,
`[label](url)`) and drops trailing punctuation, checks the result looks
like a URL, opens it in the browser, and leaves the cleaned
URL on the clipboard as a fallback.

Usage:
    fix-url            # read clipboard, open in browser, re-copy cleaned URL
    fix-url -p         # read clipboard, print + copy cleaned URL, don't open
    xclip -o | fix-url # read stdin instead of the clipboard
"""

import platform
import re
import shutil
import subprocess
import sys
from urllib.parse import urlsplit


def clean(text: str) -> str:
    return re.sub(r"\s+", "", text)


CLOSERS = {"(": ")", "[": "]", "{": "}"}
STOP_CHARS = set('<>"`')
TRAILING_PUNCT = ".,;:!?'\""


def extract(text: str) -> str:
    """Return the first http(s) URL in text, without the brackets around it.

    The URL ends at a closing bracket it didn't open, so `(url)` and
    `[label](url)` lose their brackets while a URL with balanced parentheses
    of its own (Wikipedia) keeps them. Text with no URL comes back unchanged.
    """
    match = re.search(r"https?://", text)
    if not match:
        return text
    open_brackets = []
    end = len(text)
    for i in range(match.end(), len(text)):
        ch = text[i]
        if ch in STOP_CHARS:
            end = i
            break
        if ch in CLOSERS:
            open_brackets.append(CLOSERS[ch])
        elif ch in CLOSERS.values():
            if not open_brackets or open_brackets.pop() != ch:
                end = i
                break
    return text[match.start() : end].rstrip(TRAILING_PUNCT)


def looks_like_url(text: str) -> bool:
    parts = urlsplit(text)
    return parts.scheme in ("http", "https") and bool(parts.netloc)


def _run(cmd: list[str], input_text: str | None = None) -> str:
    result = subprocess.run(
        cmd, input=input_text, capture_output=True, text=True, check=True
    )
    return result.stdout


def read_input() -> str:
    if not sys.stdin.isatty():
        return sys.stdin.read()

    if platform.system() == "Darwin":
        return _run(["pbpaste"])

    for cmd in (["xclip", "-selection", "clipboard", "-o"], ["wl-paste"]):
        if shutil.which(cmd[0]):
            return _run(cmd)

    sys.exit("fix-url: no clipboard tool found (need xclip or wl-paste)")


def write_clipboard(text: str) -> None:
    if platform.system() == "Darwin":
        _run(["pbcopy"], input_text=text)
        return

    for cmd in (
        ["xclip", "-selection", "clipboard"],
        ["wl-copy"],
    ):
        if shutil.which(cmd[0]):
            _run(cmd, input_text=text)
            return

    sys.exit("fix-url: no clipboard tool found (need xclip or wl-copy)")


def open_browser(url: str) -> None:
    opener = "open" if platform.system() == "Darwin" else "xdg-open"
    subprocess.run([opener, url], check=True)


def main() -> None:
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    print_only = bool(args and args[0] in ("-p", "--print"))

    raw = read_input()
    if not raw.strip():
        sys.exit("fix-url: no input (clipboard/stdin is empty)")

    url = extract(clean(raw))
    if not looks_like_url(url):
        sys.exit(f"fix-url: doesn't look like a URL after cleaning:\n{url}")

    write_clipboard(url)
    if print_only:
        print(url)
    else:
        open_browser(url)


if __name__ == "__main__":
    main()
