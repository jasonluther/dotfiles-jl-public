#!/usr/bin/env python3
"""fix-cmd — clean a terminal-wrapped shell command and run it.

Claude Code suggests commands like `! gcloud auth login --no-launch-browser`
and wraps long ones across lines. Copying that from the terminal leaves a
leading `!`, indentation, and embedded newlines. fix-cmd rejoins a line onto
the one before when it is a continuation: the line before ends in `\\`, the
line is indented at least 2 columns deeper than the first (1 deeper means
the copy started a column into the indent), or its first word would not
have fit in the terminal's width after the line before (where the terminal
wrapped; a line wider than the terminal was not wrapped there). A deeper line
that starts with `!` is a new command, not a continuation.
Every other line break is kept, so a multi-line snippet runs as separate
commands. It strips the leading `!` from each command (so a shell `! cmd`
negation at a line start is lost too), shows the result, and runs it in
$SHELL after you press `y` (any other key aborts, no Enter needed).

A wrap that split a single word (a long URL or path) is rejoined with a
space, and a terminal resized since the copy can misjudge a wrap, so check
the printed command before pressing `y`.

Usage:
    fix-cmd             # read clipboard, confirm, run
    fix-cmd -f          # --force: run without confirming
    pbpaste | fix-cmd   # read stdin instead of the clipboard
"""

import os
import platform
import shutil
import subprocess
import sys
import termios
import tty


def _indent(line: str) -> int:
    return len(line) - len(line.lstrip())


def clean(text: str, width: int | None = None) -> str:
    width = width or shutil.get_terminal_size().columns
    raws = [line.rstrip() for line in text.splitlines() if line.strip()]
    if not raws:
        return ""
    base = _indent(raws[0])
    out: list[str] = []
    prev = ""
    for raw in raws:
        line = raw.strip()
        if out and (
            out[-1].endswith("\\")
            or _indent(raw) >= base + 2
            and not line.startswith("!")
            or len(prev) <= width < len(prev) + 1 + len(line.split()[0])
        ):
            out[-1] = out[-1].removesuffix("\\").rstrip() + " " + line
        else:
            out.append(line.removeprefix("!").lstrip())
        prev = raw
    out[-1] = out[-1].removesuffix("\\").rstrip()
    return "\n".join(line for line in out if line)


def _run(cmd: list[str]) -> str:
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def read_input() -> str:
    if not sys.stdin.isatty():
        return sys.stdin.read()

    if platform.system() == "Darwin":
        return _run(["pbpaste"])

    for cmd in (["xclip", "-selection", "clipboard", "-o"], ["wl-paste"]):
        if shutil.which(cmd[0]):
            return _run(cmd)

    sys.exit("fix-cmd: no clipboard tool found (need xclip or wl-paste)")


def read_key() -> str:
    with open("/dev/tty") as tty_in:
        fd = tty_in.fileno()
        saved = termios.tcgetattr(fd)
        try:
            tty.setcbreak(fd)
            return tty_in.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def confirm(cmd: str) -> bool:
    shown = cmd.replace("\n", "\n  ")
    print(f"fix-cmd will run:\n\n  {shown}\n", file=sys.stderr)
    print("Run it? [y/N] ", end="", file=sys.stderr, flush=True)
    key = read_key()
    print(key if key.isprintable() else "", file=sys.stderr)
    return key == "y"


def main() -> None:
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    force = bool(args and args[0] in ("-f", "--force"))

    cmd = clean(read_input())
    if not cmd:
        sys.exit("fix-cmd: no command (clipboard/stdin is empty)")

    if force:
        print(f"fix-cmd: running: {cmd}", file=sys.stderr)
    elif not confirm(cmd):
        sys.exit("fix-cmd: aborted")

    shell = os.environ.get("SHELL") or "/bin/sh"
    os.execv(shell, [shell, "-c", cmd])


if __name__ == "__main__":
    main()
