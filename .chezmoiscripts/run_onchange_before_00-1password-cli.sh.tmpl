#!/usr/bin/env bash
# Thin wrapper for scripts/linux/setup-1password-cli.sh.
#
# Runs before install-packages so apt knows about 1password.com's repo by
# the time the package installer fires. The `00-` prefix forces this ahead
# of install-packages in lexicographic order.
#
# script hash: {{ include "scripts/linux/setup-1password-cli.sh" | sha256sum }}

{{ if eq .chezmoi.os "linux" -}}
exec {{ joinPath .chezmoi.sourceDir "scripts/linux/setup-1password-cli.sh" | quote }}
{{- else -}}
# Linux-only: skipped on {{ .chezmoi.os }}.
{{- end }}
