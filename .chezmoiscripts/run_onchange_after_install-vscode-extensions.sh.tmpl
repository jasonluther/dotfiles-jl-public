#!/usr/bin/env bash
# Install VS Code / code-server extensions listed in packages/vscode-extensions.txt.
#
# manifest hash:       {{ include "packages/vscode-extensions.txt" | sha256sum }}
# vsix-fallback hash:  {{ include "scripts/install-vscode-vsix-fallback.sh" | sha256sum }}

set -euo pipefail

SRC={{ .chezmoi.sourceDir | quote }}
MANIFEST="$SRC/packages/vscode-extensions.txt"

[[ -f "$MANIFEST" ]] || exit 0

# Read manifest, strip comments and blank lines.
extensions=()
while IFS= read -r line; do
  extensions+=("$line")
done < <(grep -vE '^[[:space:]]*(#|$)' "$MANIFEST" | awk '{$1=$1; print}')
((${#extensions[@]} > 0)) || exit 0

installers=()
command -v code        >/dev/null 2>&1 && installers+=("code")
command -v code-server >/dev/null 2>&1 && installers+=("code-server")

if ((${#installers[@]} == 0)); then
  echo "vscode-extensions: neither 'code' nor 'code-server' on PATH; skipping."
  exit 0
fi

failed_ids=()

for installer in "${installers[@]}"; do
  # Cache currently-installed list once per installer to avoid 43x shell starts.
  installed="$("$installer" --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]' | sort -u)"
  for ext in "${extensions[@]}"; do
    ext_lc="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
    if grep -Fxq "$ext_lc" <<<"$installed"; then
      continue
    fi
    if ! "$installer" --install-extension "$ext" --force >/dev/null 2>&1; then
      case " ${failed_ids[*]:-} " in
        *" $ext "*) ;;
        *) failed_ids+=("$ext") ;;
      esac
    fi
  done
done

# Retry failures via the vsix-fallback script. Handles macOS NotSigned and
# Linux code-server's Open-VSX-vs-MS-marketplace gap by downloading the
# .vsix from Microsoft's marketplace and installing it locally.
if ((${#failed_ids[@]} > 0)) && [[ -x "$SRC/scripts/install-vscode-vsix-fallback.sh" ]]; then
  echo "==> retrying ${#failed_ids[@]} extension(s) via vsix-fallback"
  if "$SRC/scripts/install-vscode-vsix-fallback.sh" -- "${failed_ids[@]}" >/dev/null 2>&1; then
    failed_ids=()
  fi
fi

if ((${#failed_ids[@]} > 0)); then
  printf '\033[1;31mvscode-extensions: failed to install:\033[0m\n' >&2
  printf '  - %s\n' "${failed_ids[@]}" >&2
  exit 1
fi
