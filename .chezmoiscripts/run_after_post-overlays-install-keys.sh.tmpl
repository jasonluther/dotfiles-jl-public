#!/usr/bin/env bash
# Install keys (kilotronic/keys), which agent sessions' gh and git go through
# (~/.local/bin/gh and ~/.config/shell/gh.sh), and give each GitHub App in
# KEYS_GH_APPS its key on this machine, once.
#
# run_after_ (not run_onchange_): the key check must run on every apply, so a
# machine that skipped it (1Password locked, no mapping yet) catches up on the
# next `chezmoi update`. Named to sort after run_after_overlays, which writes
# ~/.config/keys/apps.sh, so a fresh machine gets its key on the first apply. Once a key is in place this is silent and makes no
# network call beyond the ls-remote below.
#
# - keys itself: `uv tool install` at origin/main's commit, only when that
#   commit differs from the one installed last (kept in the state file below).
# - Each App's key: `keys install-key <app>` when this machine has none. On a
#   Mac that is the login keychain (one Touch ID prompt from 1Password); on
#   Linux, ~/.config/keys/app-keys/<app>.json. The mapping that names the
#   1Password item is the auditor's keys.toml (~/Code/gh/auditor, cloned by
#   sync-gh.py). With no mapping it prints the command to run and goes on; an
#   App the mapping doesn't name is skipped quietly. A Linux host with no
#   1Password signed in gets its keys sent from a Mac (`keys send-key <app>
#   <host>`), and this prints that command, once per apply, for the Apps it lacks.
#
# Fail-safe: nothing here stops a dotfiles apply.
#
set -uo pipefail

rev={{ output "sh" "-c" "GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=15 git ls-remote https://github.com/kilotronic/keys.git main 2>/dev/null | cut -f1 || true" | trim | quote }}
state="${XDG_STATE_HOME:-$HOME/.local/state}/keys/installed-rev"
mapping="$HOME/Code/gh/auditor/keys.toml"
export PATH="$HOME/.local/bin:$PATH"

note() { echo "keys: $*"; }

# --- keys itself -------------------------------------------------------------
if ! command -v uv >/dev/null 2>&1; then
  note "uv not installed; skipping"
  exit 0
fi
if [ -n "$rev" ] && { ! command -v keys >/dev/null 2>&1 || [ "$(cat "$state" 2>/dev/null)" != "$rev" ]; }; then
  if GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=15 \
    uv tool install --quiet --force "git+https://github.com/kilotronic/keys.git@$rev" >/dev/null 2>&1; then
    mkdir -p "$(dirname "$state")" && echo "$rev" >"$state"
    note "installed at ${rev:0:7}"
  else
    note "could not install from kilotronic/keys (offline?); skipping"
  fi
fi
command -v keys >/dev/null 2>&1 || exit 0

# --- each App's key ----------------------------------------------------------
# shellcheck source=/dev/null
[ -r "$HOME/.config/keys/apps.sh" ] && . "$HOME/.config/keys/apps.sh"
# shellcheck disable=SC2086 # split the owner=app pairs on spaces
apps=$(printf '%s\n' ${KEYS_GH_APPS:-} | tr ',' '\n' | sed -n 's/^[^=]*=//p' | sort -u)
[ -n "$apps" ] || exit 0

missing=""
for app in $apps; do
  keys has-key "$app" 2>/dev/null
  case $? in
    0) continue ;;
    1) ;;
    *)
      # A keys too old to answer: don't treat that as a missing key and prompt every apply.
      note "this keys has no has-key; skipping the key check"
      break
      ;;
  esac
  # A Linux host with no 1Password of its own: its keys come from a Mac.
  if [ "$(uname -s)" != Darwin ] && ! { command -v op >/dev/null 2>&1 && op whoami >/dev/null 2>&1; }; then
    missing="${missing:+$missing }$app"
    continue
  fi
  todo="keys install-key $app --mapping <keys.toml naming it>"
  if [ ! -r "$mapping" ]; then
    note "no key for $app here, and no $mapping; run: $todo"
    continue
  fi
  grep -q "^name *= *\"$app\"" "$mapping" || continue
  note "copying $app's key from 1Password (approve the prompt)"
  keys install-key "$app" --mapping "$mapping" || note "install-key $app failed; run: keys install-key $app --mapping $mapping"
done
if [ -n "${missing:-}" ]; then
  note "no App key here for: $missing. From a Mac, run: keys send-key <app> $(hostname -s 2>/dev/null || hostname) --mapping ~/Code/gh/auditor/keys.toml"
fi
exit 0
