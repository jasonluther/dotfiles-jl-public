#!/usr/bin/env bash
# Thin wrapper for scripts/linux/setup-nodesource.sh.
#
# Runs before install-packages so apt's nodejs candidate is NodeSource's
# v24 by the time the package installer fires. The `00-` prefix forces
# this ahead of install-packages in lexicographic order.
#
# script hash: {{ include "scripts/linux/setup-nodesource.sh" | sha256sum }}

{{ if eq .chezmoi.os "linux" -}}
exec {{ joinPath .chezmoi.sourceDir "scripts/linux/setup-nodesource.sh" | quote }}
{{- else -}}
# Linux-only: skipped on {{ .chezmoi.os }}.
{{- end }}
