#!/usr/bin/env bash
# Install PlatformIO platforms from packages/platformio.txt.
# `pio pkg install --global -p <name>` is idempotent.
#
# platformio.txt hash: {{ include "packages/platformio.txt" | sha256sum }}

set -euo pipefail

list={{ joinPath .chezmoi.sourceDir "packages/platformio.txt" | quote }}
[[ -f "$list" ]] || exit 0

if ! command -v pio >/dev/null 2>&1; then
  echo "pio not on PATH; skipping platformio.txt" >&2
  exit 0
fi

while IFS= read -r line; do
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z "$line" ]] && continue
  echo "==> pio pkg install --global --platform $line"
  pio pkg install --global --platform "$line"
done < "$list"
