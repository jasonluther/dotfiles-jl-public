    "deny": [],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/.claude/plans",
      "/tmp"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-main-edits.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/standup\" ] && \"$HOME/.local/bin/standup\" register || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/standup\" ] && \"$HOME/.local/bin/standup\" register || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.local/bin/standup\" ] && \"$HOME/.local/bin/standup\" deregister || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-code-plugins": false,
    "frontend-design@claude-code-plugins": false,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "greptile@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": false,
    "serena@claude-plugins-official": false
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
